{% comment %}Shared hero for NBJC operational-state collection templates.{% endcomment %}
{{ 'section-editorial-collection-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign is_field_issue_archive = false
  assign use_image_led_hero = false

  if section.settings.layout_variant == 'field_issue_archive'
    assign is_field_issue_archive = true
  endif

  if is_field_issue_archive and section.settings.hero_asset != blank
    assign use_image_led_hero = true
  endif
%}

<div class="editorial-collection-hero{% if is_field_issue_archive %} editorial-collection-hero--field-issue-archive{% endif %}{% if use_image_led_hero %} editorial-collection-hero--image-led{% endif %}">
  {%- if use_image_led_hero -%}
    <div class="editorial-collection-hero__wide-media page-width">
      <img
        src="{{ section.settings.hero_asset | asset_url }}"
        alt="{{ section.settings.heading_line_1 | escape }}"
        width="1920"
        height="840"
        loading="eager"
        fetchpriority="high"
      >
    </div>

    {%- if section.settings.intro_text != blank -%}
      <div class="editorial-collection-hero__intro page-width">
        <p>{{ section.settings.intro_text | escape }}</p>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="editorial-collection-hero__inner{% if section.settings.hero_asset == blank %} editorial-collection-hero__inner--no-media{% endif %} page-width">
      <div class="editorial-collection-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="editorial-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="editorial-collection-hero__heading">
          {{ section.settings.heading_line_1 | escape -}}
          {%- if section.settings.heading_line_2 != blank -%}
            <br>{{ section.settings.heading_line_2 | escape }}
          {%- endif -%}
        </h1>
        <p class="editorial-collection-hero__body">
          {{ section.settings.body_line_1 | escape -}}
          {%- if section.settings.body_line_2 != blank -%}
            <br>{{ section.settings.body_line_2 | escape -}}
          {%- endif -%}
          {%- if section.settings.body_line_3 != blank -%}
            <br>{{ section.settings.body_line_3 | escape }}
          {%- endif -%}
        </p>
        {%- if section.settings.collection_note != blank -%}
          <p class="editorial-collection-hero__note">{{ section.settings.collection_note | escape }}</p>
        {%- endif -%}
        <dl class="editorial-collection-hero__metadata">
          <div>
            <dt>{{ section.settings.metadata_label_1 | escape }}:</dt>
            <dd>{{ section.settings.metadata_value_1 | escape }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.metadata_label_2 | escape }}:</dt>
            <dd>{{ section.settings.metadata_value_2 | escape }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.metadata_label_3 | escape }}:</dt>
            <dd>{{ section.settings.metadata_value_3 | escape }}</dd>
          </div>
        </dl>
      </div>

      {%- if section.settings.hero_asset != blank -%}
        <div class="editorial-collection-hero__media">
          {%- if is_field_issue_archive and section.settings.media_label != blank -%}
            <div class="editorial-collection-hero__media-label">{{ section.settings.media_label | escape }}</div>
          {%- endif -%}
          <img
            src="{{ section.settings.hero_asset | asset_url }}"
            alt=""
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          >
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.feature_asset != blank -%}
      <div class="editorial-collection-feature page-width">
        <figure class="editorial-collection-feature__figure">
          {%- if section.settings.feature_label != blank -%}
            <figcaption class="editorial-collection-feature__label">{{ section.settings.feature_label | escape }}</figcaption>
          {%- endif -%}
          <img
            src="{{ section.settings.feature_asset | asset_url }}"
            alt=""
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          >
        </figure>
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="editorial-collection-inventory page-width">
    <h2 class="editorial-collection-inventory__title">{{ section.settings.inventory_heading | escape }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "Editorial collection hero",
  "tag": "section",
  "class": "section editorial-collection-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "hero_asset",
      "label": "Theme asset filename",
      "default": "nbjc-current-objective-collection-hero.jpeg"
    },
    {
      "type": "text",
      "id": "feature_asset",
      "label": "Feature asset filename"
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Feature label",
      "default": "COLLECTION PLATE"
    },
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Layout variant",
      "default": "operational_state",
      "options": [
        {
          "value": "operational_state",
          "label": "Operational state"
        },
        {
          "value": "field_issue_archive",
          "label": "Field Issue Archive"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CURRENT OBJECTIVE"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Reduced-capacity operation."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Progress still counts."
    },
    {
      "type": "text",
      "id": "body_line_1",
      "label": "Body line 1",
      "default": "For days when the task list got smaller,"
    },
    {
      "type": "text",
      "id": "body_line_2",
      "label": "Body line 2",
      "default": "but the day still counts."
    },
    {
      "type": "text",
      "id": "body_line_3",
      "label": "Body line 3"
    },
    {
      "type": "text",
      "id": "collection_note",
      "label": "Collection note"
    },
    {
      "type": "text",
      "id": "metadata_label_1",
      "label": "Metadata label 1",
      "default": "STATUS"
    },
    {
      "type": "text",
      "id": "metadata_value_1",
      "label": "Metadata value 1",
      "default": "ACTIVE"
    },
    {
      "type": "text",
      "id": "metadata_label_2",
      "label": "Metadata label 2",
      "default": "CAPACITY"
    },
    {
      "type": "text",
      "id": "metadata_value_2",
      "label": "Metadata value 2",
      "default": "LIMITED"
    },
    {
      "type": "text",
      "id": "metadata_label_3",
      "label": "Metadata label 3",
      "default": "SYSTEMS"
    },
    {
      "type": "text",
      "id": "metadata_value_3",
      "label": "Metadata value 3",
      "default": "FUNCTIONAL"
    },
    {
      "type": "text",
      "id": "inventory_heading",
      "label": "Inventory heading",
      "default": "AVAILABLE INVENTORY"
    },
    {
      "type": "text",
      "id": "media_label",
      "label": "Media label",
      "default": "FIELD ISSUE / BADGE REEL"
    }
  ],
  "presets": [
    {
      "name": "Editorial collection hero"
    }
  ]
}
{% endschema %}
