{{ 'section-editorial-footer.css' | asset_url | stylesheet_tag }}

<footer class="editorial-footer">
  <div class="editorial-footer__inner page-width">
    <div class="editorial-footer__brand">
      <a class="editorial-footer__mark" href="{{ routes.root_url }}">NBJC</a>
      <p class="editorial-footer__tagline">Not Broken. Just Custom.</p>
      <p class="editorial-footer__motto">Built different. On purpose.</p>
      <span class="editorial-footer__rule" aria-hidden="true"></span>
      <p class="editorial-footer__copyright">&copy; 2026 NBJC<br>All rights reserved.</p>
    </div>

    <div class="editorial-footer__groups">
      <nav class="editorial-footer__nav" aria-label="Shop">
        <h2 class="editorial-footer__title">Shop</h2>
        <ul class="editorial-footer__links list-unstyled">
          <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
          <li><a href="/pages/operational-states">Operational States</a></li>
          <li><a href="/pages/field-guide">Field Guide</a></li>
        </ul>
      </nav>

      <nav class="editorial-footer__nav" aria-label="States">
        <h2 class="editorial-footer__title">States</h2>
        <ul class="editorial-footer__links list-unstyled">
          <li><a href="/collections/current-objectives">Current Objectives</a></li>
          <li><a href="/collections/side-quests">Side Quests</a></li>
          <li><a href="/collections/recalibrating">Recalibrating</a></li>
          <li><a href="/collections/emotional-damage">Emotional Damage</a></li>
        </ul>
      </nav>

      <nav class="editorial-footer__nav" aria-label="Help">
        <h2 class="editorial-footer__title">Help</h2>
        <ul class="editorial-footer__links list-unstyled">
          <li><a href="/pages/shipping-returns">Shipping &amp; Returns</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Editorial footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Editorial footer"
    }
  ]
}
{% endschema %}
