{{ 'section-editorial-value-row.css' | asset_url | stylesheet_tag }}

<section class="editorial-value-row" aria-label="What we value">
  <div class="editorial-value-row__inner page-width">
    <div class="editorial-value">
      <span class="editorial-value__icon" aria-hidden="true">{{ 'icon-box.svg' | inline_asset_content }}</span>
      <h2 class="editorial-value__title">Made In Small Batches</h2>
      <p class="editorial-value__copy">Reasonable quantities.<br>Real care.</p>
    </div>
    <div class="editorial-value">
      <span class="editorial-value__icon" aria-hidden="true">{{ 'icon-check-mark.svg' | inline_asset_content }}</span>
      <h2 class="editorial-value__title">Built For Real Life</h2>
      <p class="editorial-value__copy">Laptops, notebooks,<br>bottles, chaos.</p>
    </div>
    <div class="editorial-value">
      <span class="editorial-value__icon" aria-hidden="true">{{ 'icon-ruler.svg' | inline_asset_content }}</span>
      <h2 class="editorial-value__title">No Fluff</h2>
      <p class="editorial-value__copy">Just useful<br>little things.</p>
    </div>
    <div class="editorial-value">
      <span class="editorial-value__icon" aria-hidden="true">{{ 'icon-heart.svg' | inline_asset_content }}</span>
      <h2 class="editorial-value__title">Real Human Support</h2>
      <p class="editorial-value__copy">Small shop.<br>Actual replies.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial value row",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Editorial value row"
    }
  ]
}
{% endschema %}
