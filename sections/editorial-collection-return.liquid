{% comment %}Shared return link for NBJC operational-state collection templates.{% endcomment %}
{{ 'section-editorial-collection-page.css' | asset_url | stylesheet_tag }}

<div class="editorial-collection-return">
  <div class="page-width">
    <a href="{{ section.settings.link }}" class="editorial-collection-return__link">
      {{ section.settings.label | escape }} &rarr;
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Editorial collection return",
  "tag": "section",
  "class": "section editorial-collection-return-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "RETURN TO OPERATIONAL STATES"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Editorial collection return"
    }
  ]
}
{% endschema %}
